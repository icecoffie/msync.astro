---
import type { Locale } from '../i18n/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = locale === 'id'
  ? { label: '[ HUBUNGI KAMI ]', title: 'Siap membangun sesuatu yang lebih baik?', name: 'Nama', email: 'Email', message: 'Pesan', submit: 'Kirim Pesan' }
  : { label: '[ GET IN TOUCH ]', title: 'Ready to build something better?', name: 'Name', email: 'Email', message: 'Message', submit: 'Send Message' };
---
<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="container contact-inner">
    <img class="section-art section-art-contact" src="/projects/me3.webp" alt="" aria-hidden="true" loading="lazy" />
    <p class="mono-label">{copy.label}</p>
    <h2 id="contact-heading">{copy.title}</h2>
    <form action="https://formspree.io/f/xjkrorey" method="POST" class="contact-form">
      <label for="contact-name">{copy.name}</label>
      <input id="contact-name" type="text" name="name" required autocomplete="name" />
      <label for="contact-email">{copy.email}</label>
      <input id="contact-email" type="email" name="email" required autocomplete="email" />
      <label for="contact-message">{copy.message}</label>
      <textarea id="contact-message" name="message" rows="6" required></textarea>
      <button class="button button-primary" type="submit">{copy.submit} <span aria-hidden="true">↗</span></button>
    </form>
  </div>
</section>
