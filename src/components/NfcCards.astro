---
import type { Locale } from '../i18n/types';
import { getNfcCopy, NFC_BUNDLE_PRICE } from '../data/nfc';

interface Props {
  locale: Locale;
  /** Renders the extra "read more" link that points at the dedicated NFC page. */
  showPageLink?: boolean;
  /** Emits Product/Offer structured data. Keep it on the dedicated page only. */
  withSchema?: boolean;
  /** Hide the heading block when the surrounding page already states it. */
  showHeading?: boolean;
}

const { locale, showPageLink = false, withSchema = false, showHeading = true } = Astro.props;
const copy = getNfcCopy(locale);
const pageHref = locale === 'id' ? '/kartu-nfc/' : '/en/nfc-cards/';
const whatsappHref = `https://wa.me/6285187732004?text=${encodeURIComponent(copy.offer.whatsapp)}`;
const readMore = locale === 'id' ? 'Lihat detail kartu NFC' : 'See the NFC card details';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: copy.offer.name,
  description: copy.intro,
  brand: { '@type': 'Brand', name: 'Matrix Sync Tech' },
  category: locale === 'id' ? 'Kartu NFC review bisnis' : 'NFC review card for business',
  offers: {
    '@type': 'Offer',
    price: String(NFC_BUNDLE_PRICE),
    priceCurrency: 'IDR',
    availability: 'https://schema.org/InStock',
    url: `https://msync.web.id${pageHref}`,
    seller: { '@type': 'Organization', name: 'Matrix Sync Tech', url: 'https://msync.web.id/' },
  },
};
---
<section id="nfc" class="nfc-section" aria-labelledby={showHeading ? 'nfc-heading' : 'nfc-offer-heading'}>
  <div class="container nfc-inner">
    {showHeading && (
      <div class="nfc-heading">
        <p class="mono-label">{copy.eyebrow}</p>
        <h2 id="nfc-heading">{copy.title}</h2>
        <p>{copy.intro}</p>
        {showPageLink && <a class="text-link" href={pageHref}>{readMore} <span aria-hidden="true">↗</span></a>}
      </div>
    )}

    <div class:list={['nfc-layout', { 'nfc-layout-flush': !showHeading }]}>
      <div>
        <p class="mono-label nfc-steps-label">{copy.stepsLabel}</p>
        <div class="nfc-steps">
          {copy.steps.map((step, index) => (
            <article class="nfc-step">
              <span class="nfc-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <aside class="nfc-offer" aria-labelledby="nfc-offer-heading">
        <span class="nfc-offer-badge">{copy.offer.badge}</span>
        <h3 id="nfc-offer-heading">{copy.offer.name}</h3>
        <p class="nfc-offer-price"><strong>{copy.offer.price}</strong><span>{copy.offer.priceNote}</span></p>
        <ul>
          {copy.offer.includes.map((item) => (
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span><b>{item.label}</b> — {item.detail}</span></li>
          ))}
        </ul>
        <p class="nfc-offer-addon">{copy.offer.addon}</p>
        <a class="button" href={whatsappHref} target="_blank" rel="noreferrer">{copy.offer.cta} <span aria-hidden="true">↗</span></a>
        <p class="nfc-offer-note">{copy.offer.note}</p>
      </aside>
    </div>

    <p class="mono-label nfc-benefits-label">{copy.benefitsLabel}</p>
    <div class="nfc-benefits">
      {copy.benefits.map((benefit) => (
        <article class="nfc-benefit">
          <i class={benefit.icon} aria-hidden="true"></i>
          <h3>{benefit.title}</h3>
          <p>{benefit.body}</p>
        </article>
      ))}
    </div>

    <div class="nfc-usecases" aria-label={copy.useCasesLabel}>
      {copy.useCases.map((useCase) => <span>{useCase}</span>)}
    </div>
  </div>
</section>
{withSchema && <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />}
