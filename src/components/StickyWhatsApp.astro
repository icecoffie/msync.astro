---
import type { Locale } from '../i18n/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const label = locale === 'id' ? 'Chat kami di WhatsApp' : 'Chat with us on WhatsApp';
---
<a class="sticky-whatsapp" href="https://wa.me/6285187732004" target="_blank" rel="noreferrer" aria-label={label} data-whatsapp-link>
  <span class="whatsapp-icon" aria-hidden="true"><svg viewBox="0 0 24 24" role="img"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.2 1.7 6L.2 24l6.4-1.7a11.8 11.8 0 0 0 5.5 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.2-3.5-8.4ZM12.2 21.6h-.1a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 0 1-1.5-5.2c0-5.4 4.4-9.8 9.9-9.8 2.6 0 5.1 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.5-4.4 9.9-9.7 9.9Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-1.6-.8-2.6-1.4-3.7-3.2-.3-.5.3-.5.8-1.7.1-.2.1-.4 0-.6-.1-.2-.7-1.6-1-2.2-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.1 3.1 1.3 3.3c.2.2 2.2 3.4 5.4 4.8 2 .9 2.8 1 3.8.8.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.2-.1-.4-.2-.7-.3Z" /></svg></span>
  <span class="whatsapp-tooltip">{label}</span>
</a>

<script>
  const whatsappLink = document.querySelector<HTMLAnchorElement>('[data-whatsapp-link]');
  if (whatsappLink) {
    const path = window.location.pathname;
    const isPricing = path.includes('pricing');
    const isPortfolio = path.includes('portofolio') || path.includes('portfolio') || path.includes('projects');
    const message = isPricing
      ? 'Halo Matrix Sync, saya ingin konsultasi tentang harga dan paket layanan.'
      : isPortfolio
        ? 'Halo Matrix Sync, saya ingin membahas project seperti yang ada di portofolio.'
        : 'Halo Matrix Sync, saya ingin konsultasi tentang kebutuhan digital bisnis saya.';
    whatsappLink.href = `https://wa.me/6285187732004?text=${encodeURIComponent(message)}`;
    if (window.matchMedia('(max-width: 800px)').matches) {
      window.setTimeout(() => whatsappLink.classList.add('tooltip-seen'), 3200);
    }
  }
</script>
