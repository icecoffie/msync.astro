<div class="preloader" id="preloader" aria-label="Loading Matrix Sync Tech">
  <div class="preloader-word" aria-hidden="true"><span>M</span><span>A</span><span>T</span><span>R</span><span>I</span><span>X</span><span>&nbsp;</span><span>S</span><span>Y</span><span>N</span><span>C</span></div>
  <p>&gt;_ Loading digital ecosystem...</p>
</div>

<script>
  const preloader = document.querySelector<HTMLElement>('#preloader');
  if (preloader) {
    window.addEventListener('load', () => {
      window.setTimeout(() => {
        preloader.classList.add('is-done');
        window.setTimeout(() => preloader.remove(), 500);
      }, 650);
    }, { once: true });
  }
</script>
