---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import CaseStudyDetail from '../../../components/CaseStudyDetail.astro';
import { en as copy } from '../../../i18n/en';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.filter(({ data }) => data.category === 'b2b' || data.category === 'ecommerce').map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const seo = { title: `${project.data.title} Case Study | Matrix Sync Tech`, description: project.data.description, canonical: `https://msync.web.id/en/portfolio/${project.id}`, ogTitle: `${project.data.title} case study | Matrix Sync Tech`, ogDescription: project.data.description, ogImage: `https://msync.web.id${project.data.image}`, twitterTitle: `${project.data.title} | Matrix Sync Tech`, twitterDescription: project.data.description, keywords: `custom web app development company, ${project.data.title} case study, Indonesia based software agency` };
---
<Layout locale="en" copy={copy} seo={seo}><CaseStudyDetail locale="en" project={project} /></Layout>