---
import InnerPage from '../../../components/InnerPage.astro';
import NfcCards from '../../../components/NfcCards.astro';
import FinalCta from '../../../components/FinalCta.astro';
import { en as copy } from '../../../i18n/en';
import { getNfcCopy } from '../../../data/nfc';

const locale = 'en' as const;
const nfc = getNfcCopy(locale);
const alternates = { id: '/kartu-nfc/', en: '/en/nfc-cards/' };
const seo = {
  title: nfc.page.seoTitle,
  description: nfc.page.seoDescription,
  canonical: 'https://msync.web.id/en/nfc-cards/',
  ogTitle: 'NFC Review Cards + Activation System',
  ogDescription: 'An NFC review card bundle with a domain, hosting, business email, and a landing page included.',
  ogImage: 'https://msync.web.id/logo.webp',
  twitterTitle: 'NFC Review Cards for Business | Matrix Sync Tech',
  twitterDescription: 'One tap and your customer leaves a rating for your business.',
  keywords: nfc.page.keywords,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: nfc.page.faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://msync.web.id/en/' },
    { '@type': 'ListItem', position: 2, name: 'NFC Review Cards', item: 'https://msync.web.id/en/nfc-cards/' },
  ],
};
---
<InnerPage
  locale={locale}
  copy={copy}
  seo={seo}
  alternates={alternates}
  eyebrow={nfc.page.heroEyebrow}
  title={nfc.page.heroTitle}
  intro={nfc.page.heroIntro}
>
  <NfcCards locale={locale} withSchema showHeading={false} />
  <section class="faq-section" aria-labelledby="nfc-faq-heading">
    <div class="container faq-inner">
      <div class="faq-heading-row"><div><p class="mono-label">[ NFC CARD FAQ ]</p><h2 id="nfc-faq-heading">{nfc.page.faqTitle}</h2></div></div>
      <div class="faq-group">
        {nfc.page.faq.map((item) => <details class="faq-item"><summary>{item.question}</summary><p>{item.answer}</p></details>)}
      </div>
    </div>
  </section>
  <FinalCta locale={locale} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</InnerPage>
