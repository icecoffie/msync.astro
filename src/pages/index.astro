---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PartnersMarquee from '../components/PartnersMarquee.astro';
import ProblemSection from '../components/ProblemSection.astro';
import SolutionPillars from '../components/SolutionPillars.astro';
import AboutStats from '../components/AboutStats.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import TechStack from '../components/TechStack.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Services from '../components/Services.astro';
import NfcCards from '../components/NfcCards.astro';
import PricingTiers from '../components/PricingTiers.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqSection from '../components/FaqSection.astro';
import Contact from '../components/Contact.astro';
import FinalCta from '../components/FinalCta.astro';
import { id as copy } from '../i18n/id';
import { getCollection } from 'astro:content';

const locale = 'id' as const;
const seo = {
	title: 'Jasa Pembuatan Website Murah & Kartu NFC Review Bisnis | Matrix Sync Tech',
	description: 'Jasa pembuatan website murah dan terpercaya di Indonesia: company profile, e-commerce, aplikasi custom, UI/UX, hosting murah, dan sistem aktivasi kartu NFC review untuk bisnis.',
	canonical: 'https://msync.web.id/',
	ogTitle: 'Jasa Website Murah & Kartu NFC Review Bisnis',
	ogDescription: 'Website, aplikasi custom, UI/UX, dan kartu NFC review yang membantu bisnis bergerak lebih jelas.',
	ogImage: 'https://msync.web.id/logo.webp',
	twitterTitle: 'Matrix Sync Tech | Solusi Digital untuk Bisnis',
	twitterDescription: 'Bangun website dan produk digital yang siap tumbuh bersama Matrix Sync Tech.',
	keywords: 'jasa pembuatan website murah, jasa pembuatan website terpercaya, jasa bikin aplikasi murah, hosting murah Indonesia, jasa pembuatan website company profile, jasa website e-commerce, kartu nfc review bisnis, sistem aktivasi kartu nfc, jasa kartu nfc google review, kartu nfc rating bisnis',
};
const caseStudies = (await getCollection('projects')).filter(({ data }) => data.category === 'b2b' || data.category === 'ecommerce');
const featuredTestimonial = (await getCollection('testimonials'))[0];
const testimonials = (await getCollection('testimonials')).map(({ data }) => data);
---
<Layout locale={locale} copy={copy} seo={seo}>
	<div class="page-shell">
		<main id="top">
			<Hero locale={locale} copy={copy} testimonials={testimonials} />
			<PartnersMarquee />
			<ProblemSection />
			<SolutionPillars />
			<AboutStats locale={locale} />
			<WhyChooseUs />
			<TechStack />
			<section id="about" class="section section-light"><div class="container split"><div><p class="mono-label">{copy.problem.eyebrow}</p><h2 class="display">{copy.problem.title}</h2></div><div><p class="body-copy">{copy.problem.body}</p><ul class="problem-list">{copy.problem.points.map((point) => <li>{point}</li>)}</ul></div></div></section>
			<section class="section section-dark"><div class="container"><p class="mono-label">{copy.solution.eyebrow}</p><h2 class="display">{copy.solution.title}</h2><p class="body-copy">{copy.solution.body}</p><div class="card-grid" style="margin-top: 60px">{copy.solution.cards.map((card, index) => <article class="info-card"><p class="mono-label">0{index + 1}</p><h3>{card.title}</h3><p>{card.body}</p></article>)}</div></div></section>
			<CaseStudies locale={locale} projects={caseStudies} />
			<Services />
			<NfcCards locale={locale} showPageLink />
			<PricingTiers />
			<PricingCalculator />
			<Testimonials />
			<FaqSection locale={locale} />
			<Contact locale={locale} />
			<FinalCta locale={locale} />
		</main>
	</div>
</Layout>
